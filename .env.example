# Copy to .env and adjust. .env is gitignored — never commit real secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=globetrotter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globetrotter

# Least-privilege role the API connects as. RLS applies to this role, not to
# the superuser above (which is used only for migrations).
APP_DB_USER=globetrotter_app
# Must match the password 005_rls.up.sql creates the role with.
APP_DB_PASSWORD=globetrotter_app

MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
ADMINER_PORT=8080

# --- API (apps/api) ----------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# The API connects as the least-privilege role so RLS is actually enforced.
# DATABASE_URL above is the superuser and is used only by migrations.
APP_DATABASE_URL=postgresql://globetrotter_app:globetrotter_app@localhost:5432/globetrotter
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173

# --- auth (issue #15) --------------------------------------------------------
# Dev-only secret. Production injects a real one; the API refuses to boot
# without it, and refuses to boot with this value when NODE_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
# Set true behind HTTPS. Left false so the cookie works on plain-http localhost.
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173

# --- mail (MailHog) ----------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@globetrotter.local
