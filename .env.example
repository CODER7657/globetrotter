# Copy to .env and adjust. .env is gitignored — never commit real secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=globetrotter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globetrotter

# Least-privilege role the API connects as. RLS applies to this role, not to
# the superuser above (which is used only for migrations).
APP_DB_USER=globetrotter_app
APP_DB_PASSWORD=change_me_locally

MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
ADMINER_PORT=8080

# --- API (apps/api) ----------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# The API connects as the least-privilege role so RLS is actually enforced.
# DATABASE_URL above is the superuser and is used only by migrations.
#
# NOTE: the password here is the one 005_rls.up.sql actually creates the role
# with ('globetrotter_app'). APP_DB_PASSWORD above says change_me_locally, which
# does not match anything — see the PR discussion.
APP_DATABASE_URL=postgresql://globetrotter_app:globetrotter_app@localhost:5432/globetrotter
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173
