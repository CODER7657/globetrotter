# Default: normalise to LF in the repo, let Git decide in the working tree.
* text=auto eol=lf

# These are executed inside Linux containers. A CRLF here produces
# "/usr/bin/env: 'bash\r': No such file or directory" — force LF always.
*.sh        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
.env*       text eol=lf

*.png binary
*.jpg binary
*.webp binary
*.pdf binary
