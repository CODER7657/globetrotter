NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# The API connects as the least-privilege role so RLS is actually enforced.
DATABASE_URL=postgres://globetrotter_app:globetrotter_app@127.0.0.1:5433/globetrotter
# Migrations and test fixtures connect as the owner.
ADMIN_DATABASE_URL=postgres://globetrotter:globetrotter@127.0.0.1:5433/globetrotter
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173

# --- auth (issue #15) --------------------------------------------------------
# Dev-only secret. Production injects a real one; the API refuses to boot
# without it, and refuses to boot with this value when NODE_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
# Set true behind HTTPS. Left false so the cookie works on plain-http localhost.
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173

# --- mail (MailHog) ----------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@globetrotter.local
