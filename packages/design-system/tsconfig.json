{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base config targets Node and omits DOM. This package emits browser
    // CSS and types consumed by the web app, so it needs the DOM lib.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
